# Configuracion de Chuletin
# Copia este archivo a .env y ajusta lo que necesites.

# Solo localhost por defecto. No lo cambies a 0.0.0.0 sin poner autenticacion.
CHULETIN_HOST=127.0.0.1
CHULETIN_PORT=8000

# Limites
CHULETIN_MAX_UPLOAD_MB=50
CHULETIN_MAX_PAGES=2000
CHULETIN_MAX_CONTEXT_CHUNKS=8

# OCR (requiere tesseract-ocr y tesseract-ocr-spa)
CHULETIN_OCR_LANG=spa+eng
CHULETIN_OCR_MAX_PAGES=40

# Precarga del modelo de embeddings al arrancar (true/false)
CHULETIN_WARMUP=true
